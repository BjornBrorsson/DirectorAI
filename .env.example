# DirectorCut-AI environment configuration
# Copy this file to .env and fill in your values.

# Gemini backend: "api" (HTTP generateContent), "cli" (gemini CLI), or
# "antigravity" (agy CLI headless mode; auth via a one-time interactive login)
GEMINI_BACKEND=api

# --- API keys (api backend only; cli/agy carry their own auth) ---------------
# Failover order for every call: FREE_KEY_MAIN -> FREE_KEY -> PAID_KEY_MAIN
# -> PAID_KEY -> backend fallback. Paid quota is only spent once both free
# keys are exhausted.
GEMINI_FREE_KEY_MAIN=
GEMINI_FREE_KEY=
# Primary paid key. Also accepted via GEMINI_API_KEY / GEMINI_PAID_KEY, but
# GEMINI_PAID_KEY_MAIN wins when several are set.
GEMINI_PAID_KEY_MAIN=
# Secondary paid key - failover target when the main key dies (401/402/403)
# or its model chain is exhausted.
GEMINI_PAID_KEY=
# Legacy alias kept working - maps to the primary key slot.
GEMINI_API_KEY=your_api_key_here

# Last-resort failover for the api backend: when every key x model pairing
# is exhausted (quota/503 storms), retry the call through this backend.
# "antigravity" is the only meaningful value (the agy CLI carries its own
# auth). Empty/unset = disabled.
# DIRECTORCUT_BACKEND_FALLBACK=antigravity

# Default model for everything not overridden below.
GEMINI_MODEL=gemini-3.7-flash
# Optional cheaper model for high-volume classification calls
# (Pass 2 visual chunks, asset interpretation); falls back to GEMINI_MODEL.
GEMINI_MODEL_FAST=
# Optional ordered failover chains per task, comma-separated model ids.
# On persistent 429-quota / repeated 5xx the client falls through to the next
# model (warning logged). Unset -> just the single configured model.
# GEMINI_MODEL_CHAIN_DIRECTOR=gemini-3.8-flash,gemini-flash-lite-latest
# GEMINI_MODEL_CHAIN_VISUAL=gemini-flash-lite-latest
# GEMINI_MODEL_CHAIN_INTERPRET=
# GEMINI_MODEL_CHAIN_NARRATIVE=
# GEMINI_MODEL_CHAIN_AUDIO=
# Optional: path to the gemini CLI binary and model override for CLI mode
GEMINI_CLI_BIN=
GEMINI_CLI_MODEL=
# Optional: same overrides for the Antigravity (agy) backend
ANTIGRAVITY_CLI_BIN=
ANTIGRAVITY_CLI_MODEL=
ANTIGRAVITY_PRINT_TIMEOUT=15m
# Headless agy can't prompt for tool permissions; auto-approve so it can
# inspect media files inside its throwaway workspace (set false to lock down)
ANTIGRAVITY_SKIP_PERMISSIONS=true

# ElevenLabs (optional): enables AI-generated SFX, music cues, and Scribe STT
ELEVENLABS_API_KEY=
ELEVENLABS_MUSIC_MODEL=music_v2
# Voice ID for `directorcut pickup` spoken-line generation (cloning UI ->
# copy the voice's ID here). Not a secret, but kept with the keys anyway.
ELEVENLABS_VOICE_ID=

# Paths (optional; auto-detected if left blank)
FFMPEG_PATH=
FFPROBE_PATH=

# Directories
INGEST_DIR=./ingest
OUTPUT_DIR=./output

# FCPXML flavour: resolve (default; bakes ducked music/SFX beds, no <param>
# keyframes - Resolve ignores them) | fcpx (keyframe ducking for Final Cut)
# | premiere (same XML shape as fcpx; unverified - see docs/wiki/nle_targets.md)
DIRECTORCUT_FCPXML_TARGET=resolve

# Hard run spend cap in USD over output/<project>/costs.json (Gemini tokens +
# ElevenLabs minutes). On breach the run aborts with a clear message;
# checkpoints survive, so raising the cap and re-running resumes.
# DIRECTORCUT_COST_CAP_USD=1.50

# Ingest-time A-roll media prep (see docs/wiki/ingestion_proxy.md)
# Bake portrait/rotated or non-16:9 A-roll to flat 1920x1080 h264:
DIRECTORCUT_REFRAME_AROLL=true
# Normalize A-roll/voiceover voice to -16 LUFS/-1.5dBTP (skips files already
# inside -18..-15 LUFS):
DIRECTORCUT_NORMALIZE_VOICE=false

# Pass-2 visual frame sampling (cost lever): frames are sent to the model
# at ~350 tokens each and dominate run spend. 1.0 = every second (default);
# 0.2 = one frame per 5s (~5x cheaper, still fine for B-roll relevance).
# DIRECTORCUT_VISUAL_FPS=1.0

# Post-director hard targets (override direction parsing when set):
# DIRECTORCUT_TARGET_LENGTH_S accepts a range "420-540"/"7:00-9:00" or a
# single aim ("480" = +-10% window); DIRECTORCUT_BROLL_COVERAGE_MIN is 0..1.
# DIRECTORCUT_TARGET_LENGTH_S=
# DIRECTORCUT_BROLL_COVERAGE_MIN=

# App mode: dev | test | prod
DIRECTORCUT_ENV=dev

# Logging: DEBUG | INFO | WARNING | ERROR
DIRECTORCUT_LOG_LEVEL=INFO

# Web
API_HOST=127.0.0.1
API_PORT=8000
