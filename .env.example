# DirectorCut-AI environment configuration
# Copy this file to .env and fill in your values.

# Gemini
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# Paths (optional; auto-detected if left blank)
FFMPEG_PATH=
FFPROBE_PATH=

# Directories
INGEST_DIR=./ingest
OUTPUT_DIR=./output

# App mode: dev | test | prod
DIRECTORCUT_ENV=dev

# Logging: DEBUG | INFO | WARNING | ERROR
DIRECTORCUT_LOG_LEVEL=INFO

# Web
API_HOST=127.0.0.1
API_PORT=8000
